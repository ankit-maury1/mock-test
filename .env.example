# Prayas Coaching — Environment Variables

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string.
# Create a free cluster at https://cloud.mongodb.com/, then get the connection string
# from: Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/axis-exam?retryWrites=true&w=majority

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# ImgBB API key — enables permanent cloud image hosting for question photos.
# Without this, images are stored inline as base64 (still works, just larger).
# Get your free key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# Session signing secret — a random 32-character string.
# If omitted, Axis derives one from MONGODB_URI (fine for dev, set explicitly in prod).
# Generate: openssl rand -hex 32
AUTH_SECRET=your_random_32_character_secret_here
